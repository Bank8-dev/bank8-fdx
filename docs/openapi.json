          "data_clusters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duration_days": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "provider_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "recipient_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
