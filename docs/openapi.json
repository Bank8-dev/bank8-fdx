          "provider_id",
          "scopes"
        ],
        "properties": {
          "app_redirect_uri": {
            "type": [
              "string",
              "null"
            ],
            "description": "The app frontend URL to redirect back to after consent (passed by\nBFF from the TLS hostname). Encoded into the OAuth `state` so it\nsurvives the PAR/authorize/callback round-trip."
          },
          "customer_id": {
            "type": "string",
            "format": "uuid"
          },
          "provider_id": {
            "type": "string"
          },
          "redirect_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdateProviderProfileRequest": {
        "type": "object",
        "required": [
