            "type": "string",
            "format": "uuid"
          },
          "data_clusters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duration_days": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "provider_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "recipient_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreatePaymentRequest": {
        "type": "object",
