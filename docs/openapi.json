  "components": {
    "schemas": {
      "ConsentCallbackQuery": {
        "type": "object",
        "description": "Query params for `GET /fdx/consents/callback` — the OAuth callback after\nthe customer approves/denies consent at the provider's Auth.",
        "properties": {
          "app_redirect_uri": {
            "type": [
              "string",
              "null"
            ],
            "description": "The app return URL (passed through from BFF as `app_redirect_uri`)."
          },
          "code": {
            "type": [
              "string",
              "null"
            ],
            "description": "The authorization code from Auth."
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "OAuth error if the customer denied."
          },
          "selected_account_ids": {
            "type": [
              "string",
              "null"
            ],
            "description": "Comma-separated list of account IDs the customer selected to share\nduring the provider's consent screen (FDX UX Guidelines §3.1.6).\nPassed through from Auth's authorize/continue as a query param on\nthe redirect_uri."
          },
          "state": {
            "type": [
              "string",
              "null"
            ],
            "description": "The consent_id (passed as OAuth `state` in the PAR request)."
          }
        }
      },
      "ConsentResponse": {
        "type": "object",
        "required": [
          "id",
          "customer_id",
          "status",
          "scopes",
