    "/v1/recipient/providers": {
      "get": {
        "tags": [
          "fdx"
        ],
        "summary": "`GET /v1/recipient/providers` — list FDX data providers from the\n`provider_profiles` registry.\nProvider profiles are auto-registered when an environment's\n`is_fdx_provider` flag is turned on (see Sys `update_env`), with the\nenv's auth domain used as the issuer URL. The table has no RLS, so the\ncatalog is visible cross-org — any recipient can discover and connect to\nany active provider. No static seed data is required.\nResponse shape matches the eFintech recipient catalog contract:\n`{ \"providers\": [{ id, name, supportedDataClusters, status, ... }] }`,\nwhere each card reads `name`, `supportedDataClusters`, and `status`.",
        "operationId": "list_recipient_providers",
        "responses": {
          "200": {
            "description": "List of FDX data providers",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "Missing fdx:read scope"
          }
        },
        "security": [
          {
            "fdx:read": []
          }
        ]
      }
    },
